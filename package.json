{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pdf-assets": "node scripts/copy-pdf-viewer-assets.mjs",
    "dev": "npm run pdf-assets && CHOKIDAR_USEPOLLING=true vite --host 0.0.0.0",
    "start": "npm run pdf-assets && CHOKIDAR_USEPOLLING=true vite --host 0.0.0.0",
    "build": "npm run pdf-assets && vite build && npm run sitemap",
    "preview": "node dist/analog/server/index.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@analogjs/platform": "^2.5.0",
    "@analogjs/router": "^2.5.0",
    "@angular/animations": "^21.2.12",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-server": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@fontsource/lusitana": "^5.2.8",
    "ngx-extended-pdf-viewer": "^27.0.0",
    "rxjs": "^7.8.2",
    "simple-icons": "^16.19.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.0",
    "@angular/build": "^21.2.10",
    "@angular/compiler-cli": "^21.2.12",
    "nitropack": "^2.13.4",
    "sass": "^1.99.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.0.15"
  }
}
